# Application
NODE_ENV=development

# Vinted research defaults. Placeholders only; never store real cookies/tokens here.
VINTED_MARKET=fr
VINTED_PUBLIC_BASE_URL=https://www.vinted.fr
VINTED_API_BASE_URL=https://api.vinted.fr

# Optional integration-test toggles. Disabled by default.
VINTED_ENABLE_LIVE_TESTS=false
